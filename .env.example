# Reuse the math-tutoring web app configuration. These are public Firebase identifiers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=johns-tutoring.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=johns-tutoring
VITE_FIREBASE_STORAGE_BUCKET=johns-tutoring.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_BASE_PATH=/tutoring-manager/
# Local testing only; never enable in production.
VITE_USE_FIREBASE_EMULATOR=false
# Scripts only (never prefix credentials with VITE_):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT=<JSON supplied by Actions secret>
# SMTP_USER=owner@gmail.com
# SMTP_PASSWORD=<Gmail app password>
# OWNER_EMAIL=owner@gmail.com
